{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "resourceGroupBaseName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "labUserPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "labUserPrincipalType": {
      "value": "${LAB_USER_PRINCIPAL_TYPE=User}"
    },
    "vnetAddressPrefix": {
      "value": "${VNET_ADDRESS_PREFIX=10.30.0.0/16}"
    },
    "bastionSkuName": {
      "value": "${BASTION_SKU_NAME=Basic}"
    },
    "vmAdminUsername": {
      "value": "${VM_ADMIN_USERNAME=azureuser}"
    },
    "vmAdminPassword": {
      "value": "${VM_ADMIN_PASSWORD}"
    },
    "vmSize": {
      "value": "${VM_SIZE=Standard_D2s_v5}"
    },
    "firewallSkuTier": {
      "value": "${FIREWALL_SKU_TIER=Basic}"
    },
    "threatIntelMode": {
      "value": "${THREAT_INTEL_MODE=Alert}"
    },
    "deployLogAnalytics": {
      "value": "${DEPLOY_LOG_ANALYTICS=true}"
    },
    "existingLogAnalyticsWorkspaceId": {
      "value": "${EXISTING_LOG_ANALYTICS_WORKSPACE_ID=}"
    },
    "subnetNsgPolicyEffect": {
      "value": "${SUBNET_NSG_POLICY_EFFECT=Audit}"
    }
  }
}
