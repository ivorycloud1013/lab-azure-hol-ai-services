{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "labClientIpAddress": {
      "value": "${LAB_CLIENT_IP}"
    },
    "labUserPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "labUserPrincipalType": {
      "value": "${LAB_USER_PRINCIPAL_TYPE=User}"
    },
    "vnetAddressPrefix": {
      "value": "${PUBLIC_VNET_ADDRESS_PREFIX=10.10.0.0/16}"
    },
    "deployLogAnalytics": {
      "value": "${DEPLOY_LOG_ANALYTICS=false}"
    },
    "existingLogAnalyticsWorkspaceId": {
      "value": "${EXISTING_LOG_ANALYTICS_WORKSPACE_ID=}"
    }
  }
}
